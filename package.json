{
  "name": "@seven.io/mcp",
  "version": "1.1.1",
  "description": "MCP server for seven.io API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server-factory": {
      "types": "./dist/server-factory.d.ts",
      "import": "./dist/server-factory.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "seven-mcp": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "prepare": "npm run build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "keywords": [
    "mcp",
    "seven.io",
    "sms",
    "voice",
    "rcs"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seven-io/seven-mcp.git"
  },
  "homepage": "https://github.com/seven-io/seven-mcp#readme",
  "bugs": {
    "url": "https://github.com/seven-io/seven-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "axios": "^1.6.0",
    "keytar": "^7.9.0",
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  }
}
